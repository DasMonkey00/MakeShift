TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 328796390}
  m_Text: "SURVIVAL CAMP\n\n1 Put a log in the stone ring.\n2 Hit FLINT against STONE\n  over the logs for sparks.\n3 Hold meat by the fire:\n  raw, cooked, then burnt.\n4 Hold food to your mouth.\n5 Water puts the fire out.\nNight: raiders steal meat.\nBonk them, then butcher them."
  m_OffsetZ: 0
  m_CharacterSize: 0.0042
  m_LineSpacing: 1
  m_Anchor: 4
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 40
